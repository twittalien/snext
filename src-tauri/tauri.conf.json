{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snext",
  "version": "2.0.0",
  "identifier": "app.snext.dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Snext",
        "width": 1920,
        "height": 1080,
        "fullscreen": false,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Companion dashboard para tu sesion de juego",
    "longDescription": "Snext detecta tu juego activo y muestra arte, logros, musica, clima, sistema y asistencia contextual.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
